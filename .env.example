# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/recipe_extractor"

# ─────────────────────────────────────────────
# NextAuth
# Generate a secret: openssl rand -base64 32
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# OpenAI  (for recipe extraction)
# ─────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────
# Stripe  (for subscriptions)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs — create these in your Stripe dashboard
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..."   # Premium $2.99/month
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."       # Pro $9.99/month
STRIPE_LIFETIME_PRICE_ID="price_..."          # Lifetime $50 one-time payment
# STRIPE_PRO_YEARLY_PRICE_ID is retired — Lifetime replaced the yearly Pro plan.

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
